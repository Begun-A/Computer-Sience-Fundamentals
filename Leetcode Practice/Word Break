# Algorithm pattern: 1-D Dinamic Programming

# Task:
# Given a string s and a dictionary of strings wordDict, return true if s can be segmented into a space-separated sequence of one or more dictionary words.
# Note that the same word in the dictionary may be reused multiple times in the segmentation.

# Version 2
class Solution(object):
    def wordBreak(self, s, wordDict):
        """
        :type s: str
        :type wordDict: List[str]
        :rtype: bool
        """
        wordDict = ['cats', 'string']
        n = len(s)
        dp = [False] * (n + 1)
        dp[0] = True

        for i in range(1, n + 1):          
            for w in wordDict:
                # Check if current word is present
                # the prefix before the word is also
                # breakable
                start = i - len(w)
                if start >= 0 and dp[start] and s[start: start + len(w)] == w:
                    print(start, s[start: start + len(w)])
                    dp[i] = True
                    break
        print(dp)
        return True if dp[n] else False

# Version 1 
# Doesn't work case: s = "aaaaaaa", wordDict = ["aaaa","aaa"]
class Solution(object):
    def wordBreak(self, s, wordDict):
        """
        :type s: str
        :type wordDict: List[str]
        :rtype: bool
        """
        hash_map = {w for w in wordDict}

        left, right = 0, 0
        word = ""
        while right !=  len(s):
            word += s[right]
            if word in hash_map:
                right += 1
                left = right
                word = ""
            else:
                right += 1
        return not word
